# ─── ZTCE Backend Environment Variables ─────────────────────────────────────
# Copy this file to .env and customize for your deployment

# Django secret key (generate a strong random key for production)
ZTCE_SECRET_KEY=ztce-dev-key-change-in-production

# Debug mode (set to false in production/air-gapped deployments)
ZTCE_DEBUG=true

# Allowed hosts (comma-separated, * for development)
ZTCE_ALLOWED_HOSTS=*

# Redis channel layer (set to true for multi-server deployments)
USE_REDIS_CHANNEL_LAYERS=false
REDIS_HOST=127.0.0.1

# Ollama local AI (zero-trust — no data leaves the network)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Fernet encryption key for at-rest data encryption
# If not set, derives from ZTCE_SECRET_KEY via SHA-256
ZTCE_ENCRYPTION_KEY=

# Optional: Gemini API key (only for non-air-gapped fallback mode)
GEMINI_API_KEY=
